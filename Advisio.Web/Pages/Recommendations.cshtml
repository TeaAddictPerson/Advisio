@page
@model Advisio.Web.Pages.RecommendationsModel
@{
    ViewData["Title"] = "Рекомендации";
}

<div class="container mt-4">
    <h1 class="mb-4">Персональные рекомендации</h1>
    
    <div id="recommendationsContainer" class="row">
        <!-- Рекомендации будут загружены через JavaScript -->
    </div>
</div>

@section Scripts {
    <script>
        let userId = null;
        
        async function getUserId() {
            try {
                const response = await fetch('/api/auth/check');
                const data = await response.json();
                if (data.isAuthenticated) {
                    userId = data.userId;
                }
            } catch (error) {
                console.error('Ошибка получения userId:', error);
            }
        }
        
        async function loadRecommendations() {
            const container = document.getElementById('recommendationsContainer');
            if (!userId) {
                container.innerHTML = 
                    '<div class="col-12"><div class="alert alert-warning">Необходимо войти в систему для получения рекомендаций. <a href="/Login" class="alert-link">Войти</a></div></div>';
                return;
            }
            try {
                container.innerHTML = '<div class="col-12 text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Загрузка...</span></div></div>';
                const response = await fetch(`/api/recommendations?userId=${userId}&count=20`);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                const recommendations = await response.json();
                if (!recommendations || recommendations.length === 0) {
                    container.innerHTML = 
                        '<div class="col-12"><div class="alert alert-info"><h5>Рекомендации не найдены</h5><p>Пройдите опрос для получения персональных рекомендаций.</p><a href="/Survey" class="btn btn-primary">Пройти опрос</a></div></div>';
                    return;
                }
                displayRecommendations(recommendations);
            } catch (error) {
                console.error('Ошибка загрузки рекомендаций:', error);
                container.innerHTML = 
                    '<div class="col-12"><div class="alert alert-danger">Ошибка загрузки рекомендаций. Попробуйте обновить страницу.</div></div>';
            }
        }

        function displayRecommendations(recommendations) {
            const container = document.getElementById('recommendationsContainer');
            container.innerHTML = '';

            if (recommendations.length === 0) {
                container.innerHTML = `
                    <div class="col-12">
                        <div class="alert alert-info">
                            <h5>Рекомендации не найдены</h5>
                            <p>Пройдите опрос для получения персональных рекомендаций.</p>
                            <a href="/Survey" class="btn btn-primary">Пройти опрос</a>
                        </div>
                    </div>
                `;
                return;
            }

            recommendations.forEach(rec => {
                const place = rec.place;
                const card = `
                    <div class="col-md-4 mb-4" id="place-card-${place.id}">
                        <div class="card h-100 border-success">
                            <div class="card-header bg-success text-white">
                                <small>Оценка: ${rec.score.toFixed(1)}</small>
                            </div>
                            ${place.imageUrl ? `<img src="${place.imageUrl}" class="card-img-top" alt="${place.name}" style="height: 200px; object-fit: cover;">` : ''}
                            <div class="card-body">
                                <h5 class="card-title">${place.name}</h5>
                                <p class="card-text">${place.description.substring(0, 100)}${place.description.length > 100 ? '...' : ''}</p>
                                ${rec.reason ? `<p class="text-muted small"><em>${rec.reason}</em></p>` : ''}
                                <div class="mb-2">
                                    ${place.type ? `<span class="badge bg-success me-1">${place.type}</span>` : ''}
                                    ${place.categories.map(cat => `<span class="badge bg-secondary me-1">${cat}</span>`).join('')}
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted" id="likes-count-${place.id}">${place.likesCount} лайков</small>
                                    <div>
                                        <button class="btn btn-sm ${place.isFavorite ? 'btn-warning' : 'btn-outline-warning'}" id="favorite-btn-${place.id}" onclick="toggleFavorite(${place.id}, ${place.isFavorite ? 'true' : 'false'})">
                                            ${place.isFavorite ? '★' : '☆'}
                                        </button>
                                        <button class="btn btn-sm ${place.isLiked ? 'btn-danger' : 'btn-outline-danger'}" id="like-btn-${place.id}" onclick="toggleLike(${place.id}, ${place.isLiked ? 'true' : 'false'})">
                                            ${place.isLiked ? '❤️' : '🤍'}
                                        </button>
                                    </div>
                                </div>
                                <a href="/Place/${place.id}" class="btn btn-primary btn-sm mt-2">Подробнее</a>
                            </div>
                        </div>
                    </div>
                `;
                container.innerHTML += card;
            });
        }

        async function toggleFavorite(placeId, isFavorite) {
            if (!userId) {
                alert('Необходимо войти в систему');
                window.location.href = '/Login';
                return;
            }
            try {
                // Преобразуем строку в булево значение, если нужно
                const isFav = isFavorite === true || isFavorite === 'true';
                const method = isFav ? 'DELETE' : 'POST';
                const response = await fetch(`/api/places/${placeId}/favorites?userId=${userId}`, {
                    method: method
                });
                if (response.ok) {
                    // Обновляем только UI конкретного места, не перезагружая все рекомендации
                    await updatePlaceUI(placeId);
                } else {
                    const errorData = await response.json();
                    console.error('Ошибка:', errorData);
                }
            } catch (error) {
                console.error('Ошибка:', error);
            }
        }

        async function toggleLike(placeId, isLiked) {
            if (!userId) {
                alert('Необходимо войти в систему');
                window.location.href = '/Login';
                return;
            }
            try {
                // Преобразуем строку в булево значение, если нужно
                const isLk = isLiked === true || isLiked === 'true';
                const method = isLk ? 'DELETE' : 'POST';
                const response = await fetch(`/api/places/${placeId}/likes?userId=${userId}`, {
                    method: method
                });
                if (response.ok) {
                    // Обновляем только UI конкретного места, не перезагружая все рекомендации
                    await updatePlaceUI(placeId);
                } else {
                    const errorData = await response.json();
                    console.error('Ошибка:', errorData);
                }
            } catch (error) {
                console.error('Ошибка:', error);
            }
        }

        async function updatePlaceUI(placeId) {
            try {
                // Получаем обновленную информацию о месте
                const response = await fetch(`/api/places/${placeId}?userId=${userId}`);
                if (response.ok) {
                    const place = await response.json();
                    
                    // Обновляем количество лайков
                    const likesCountElement = document.getElementById(`likes-count-${placeId}`);
                    if (likesCountElement) {
                        likesCountElement.textContent = `${place.likesCount} лайков`;
                    }
                    
                    // Обновляем кнопку лайка
                    const likeBtn = document.getElementById(`like-btn-${placeId}`);
                    if (likeBtn) {
                        if (place.isLiked) {
                            likeBtn.className = 'btn btn-sm btn-danger';
                            likeBtn.innerHTML = '❤️';
                            likeBtn.setAttribute('onclick', `toggleLike(${placeId}, true)`);
                        } else {
                            likeBtn.className = 'btn btn-sm btn-outline-danger';
                            likeBtn.innerHTML = '🤍';
                            likeBtn.setAttribute('onclick', `toggleLike(${placeId}, false)`);
                        }
                    }
                    
                    // Обновляем кнопку избранного
                    const favoriteBtn = document.getElementById(`favorite-btn-${placeId}`);
                    if (favoriteBtn) {
                        if (place.isFavorite) {
                            favoriteBtn.className = 'btn btn-sm btn-warning';
                            favoriteBtn.innerHTML = '★';
                            favoriteBtn.setAttribute('onclick', `toggleFavorite(${placeId}, true)`);
                        } else {
                            favoriteBtn.className = 'btn btn-sm btn-outline-warning';
                            favoriteBtn.innerHTML = '☆';
                            favoriteBtn.setAttribute('onclick', `toggleFavorite(${placeId}, false)`);
                        }
                    }
                }
            } catch (error) {
                console.error('Ошибка обновления UI:', error);
            }
        }

        (async () => {
            try {
                await getUserId();
                if (userId) {
                    loadRecommendations();
                } else {
                    document.getElementById('recommendationsContainer').innerHTML = 
                        '<div class="col-12"><div class="alert alert-warning">Необходимо войти в систему для получения рекомендаций. <a href="/Login" class="alert-link">Войти</a></div></div>';
                }
            } catch (error) {
                console.error('Ошибка инициализации:', error);
                document.getElementById('recommendationsContainer').innerHTML = 
                    '<div class="col-12"><div class="alert alert-danger">Ошибка инициализации. Попробуйте обновить страницу.</div></div>';
            }
        })();
    </script>
}

