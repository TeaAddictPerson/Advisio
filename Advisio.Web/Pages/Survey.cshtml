@page
@model Advisio.Web.Pages.SurveyModel
@{
    ViewData["Title"] = "Опрос";
}

<div class="container mt-4">
    <h1 class="mb-4">Опрос о предпочтениях отдыха</h1>
    
    <!-- Индикатор прогресса -->
    <div id="progressIndicator" class="mb-4" style="display: none;">
        <div class="progress" style="height: 25px;">
            <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" 
                 role="progressbar" style="width: 0%">
                <span id="progressText">0 / 0</span>
            </div>
        </div>
    </div>
    
    <!-- Карточка результата -->
    <div id="surveyResultCard" class="card mb-4" style="display: none;">
        <div class="card-body">
            <h5 class="card-title">Результат опроса</h5>
            <p class="card-text" id="resultText"></p>
            <a href="/Recommendations" class="btn btn-primary">Посмотреть рекомендации</a>
        </div>
    </div>
    
    <div id="surveyContainer">
        <!-- Опрос будет загружен через JavaScript -->
    </div>
</div>

@section Scripts {
    <script>
        let userId = null;
        let surveyData = null;
        
        async function getUserId() {
            try {
                const response = await fetch('/api/auth/check');
                const data = await response.json();
                if (data.isAuthenticated) {
                    userId = data.userId;
                } else {
                    document.getElementById('surveyContainer').innerHTML = 
                        '<div class="alert alert-warning">Необходимо войти в систему для прохождения опроса. <a href="/Login" class="alert-link">Войти</a></div>';
                    return false;
                }
                return true;
            } catch (error) {
                console.error('Ошибка получения userId:', error);
                return false;
            }
        }

        async function loadSurvey() {
            try {
                const response = await fetch('/api/survey/active');
                if (response.status === 404) {
                    document.getElementById('surveyContainer').innerHTML = 
                        '<div class="alert alert-warning">Активный опрос не найден</div>';
                    return;
                }
                surveyData = await response.json();
                displaySurvey(surveyData);
            } catch (error) {
                console.error('Ошибка загрузки опроса:', error);
            }
        }

        function displaySurvey(survey) {
            const container = document.getElementById('surveyContainer');
            const progressIndicator = document.getElementById('progressIndicator');
            const progressBar = document.getElementById('progressBar');
            const progressText = document.getElementById('progressText');
            
            // Показываем индикатор прогресса
            progressIndicator.style.display = 'block';
            updateProgress(0, survey.questions.length);
            
            let html = `
                <div class="card">
                    <div class="card-header">
                        <h3>${survey.title}</h3>
                        <p>${survey.description}</p>
                    </div>
                    <div class="card-body">
                        <form id="surveyForm">
            `;

            survey.questions.forEach((question, qIndex) => {
                html += `
                    <div class="mb-4 question-block" data-question-id="${question.id}">
                        <h5>${qIndex + 1}. ${question.questionText}</h5>
                        <div class="form-group">
                `;
                question.answers.forEach(answer => {
                    html += `
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="question_${question.id}" 
                                   id="answer_${answer.id}" value="${answer.id}" required
                                   onchange="updateProgressFromForm()">
                            <label class="form-check-label" for="answer_${answer.id}">
                                ${answer.answerText}
                            </label>
                        </div>
                    `;
                });
                html += `
                        </div>
                    </div>
                `;
            });

            html += `
                            <button type="submit" class="btn btn-primary btn-lg">Отправить ответы</button>
                        </form>
                    </div>
                </div>
            `;

            container.innerHTML = html;

            document.getElementById('surveyForm').addEventListener('submit', async (e) => {
                e.preventDefault();
                await submitSurvey();
            });
        }

        function updateProgress(answered, total) {
            const progressBar = document.getElementById('progressBar');
            const progressText = document.getElementById('progressText');
            const percentage = total > 0 ? (answered / total) * 100 : 0;
            
            progressBar.style.width = percentage + '%';
            progressText.textContent = `${answered} / ${total}`;
            
            if (answered === total) {
                progressBar.classList.remove('progress-bar-animated');
                progressBar.classList.add('bg-success');
            }
        }

        function updateProgressFromForm() {
            if (!surveyData) return;
            
            const form = document.getElementById('surveyForm');
            const formData = new FormData(form);
            let answered = 0;
            
            surveyData.questions.forEach(question => {
                if (formData.get(`question_${question.id}`)) {
                    answered++;
                }
            });
            
            updateProgress(answered, surveyData.questions.length);
        }

        async function submitSurvey() {
            if (!userId) {
                alert('Необходимо войти в систему');
                window.location.href = '/Login';
                return;
            }
            
            const form = document.getElementById('surveyForm');
            const formData = new FormData(form);
            
            const responses = [];
            surveyData.questions.forEach(question => {
                const answerId = formData.get(`question_${question.id}`);
                if (answerId) {
                    responses.push({
                        questionId: question.id,
                        answerId: parseInt(answerId)
                    });
                }
            });

            if (responses.length !== surveyData.questions.length) {
                alert('Пожалуйста, ответьте на все вопросы');
                return;
            }

            try {
                const response = await fetch(`/api/survey/submit?userId=${userId}`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        surveyId: surveyData.id,
                        responses: responses
                    })
                });

                if (response.ok) {
                    const result = await response.json();
                    
                    // Скрываем форму опроса
                    document.getElementById('surveyContainer').style.display = 'none';
                    document.getElementById('progressIndicator').style.display = 'none';
                    
                    // Показываем карточку результата
                    const resultCard = document.getElementById('surveyResultCard');
                    const resultText = document.getElementById('resultText');
                    
                    if (result.favoriteCategoryName) {
                        resultText.textContent = `Похоже, ваша любимая категория отдыха - ${result.favoriteCategoryName}. Мы подобрали для вас места из этой категории!`;
                    } else {
                        resultText.textContent = 'Опрос успешно отправлен! Теперь вы можете получить персональные рекомендации.';
                    }
                    
                    resultCard.style.display = 'block';
                } else {
                    const error = await response.json();
                    alert('Ошибка: ' + (error.error || 'Не удалось отправить опрос'));
                }
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Произошла ошибка при отправке опроса');
            }
        }

        (async () => {
            try {
                const isAuthenticated = await getUserId();
                if (isAuthenticated) {
                    loadSurvey();
                } else {
                    const container = document.getElementById('surveyContainer');
                    if (container) {
                        container.innerHTML = 
                            '<div class="alert alert-warning">Необходимо войти в систему для прохождения опроса. <a href="/Login" class="alert-link">Войти</a></div>';
                    }
                }
            } catch (error) {
                console.error('Ошибка инициализации опроса:', error);
                const container = document.getElementById('surveyContainer');
                if (container) {
                    container.innerHTML = 
                        '<div class="alert alert-danger">Ошибка загрузки опроса. Попробуйте обновить страницу.</div>';
                }
            }
        })();
    </script>
}

