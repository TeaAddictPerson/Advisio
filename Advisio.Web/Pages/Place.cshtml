@page "/Place/{id}"
@model Advisio.Web.Pages.PlaceModel
@{
    ViewData["Title"] = "Место";
}

<div class="container mt-4" id="placeContainer">
    <!-- Детали места будут загружены через JavaScript -->
</div>

@section Scripts {
    <script>
        let userId = null;
        let userRole = null;
        let currentPlace = null;
        const placeId = @Model.Id;
        const urlParams = new URLSearchParams(window.location.search);
        const isEditMode = urlParams.get('edit') === 'true';
        
        async function getUserId() {
            try {
                const response = await fetch('/api/auth/check');
                const data = await response.json();
                if (data.isAuthenticated) {
                    userId = data.userId;
                    userRole = data.role;
                }
            } catch (error) {
                console.error('Ошибка получения userId:', error);
            }
        }
        
        function isAdmin() {
            return userRole === 'Admin';
        }

        async function loadPlace() {
            const container = document.getElementById('placeContainer');
            if (!container) {
                console.error('Контейнер для места не найден');
                return;
            }
            
            try {
                // Пытаемся получить userId, если его еще нет
                if (!userId) {
                    try {
                        await getUserId();
                    } catch (e) {
                        console.warn('Не удалось получить userId, продолжаем без него:', e);
                    }
                }
                
                container.innerHTML = '<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Загрузка...</span></div></div>';
                
                const url = userId ? `/api/places/${placeId}?userId=${userId}` : `/api/places/${placeId}`;
                const response = await fetch(url);
                
                if (response.status === 404) {
                    container.innerHTML = 
                        '<div class="alert alert-warning">Место не найдено</div>';
                    return;
                }
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const place = await response.json();
                displayPlace(place);
            } catch (error) {
                console.error('Ошибка загрузки места:', error);
                container.innerHTML = 
                    '<div class="alert alert-danger">Ошибка загрузки места. Попробуйте обновить страницу.</div>';
            }
        }

        function formatDescription(description) {
            if (!description) return '';
            // Заменяем переносы строк на <br>
            let formatted = description.replace(/\n/g, '<br>');
            // Заменяем <b> на <strong> для жирного текста
            formatted = formatted.replace(/<b>/g, '<strong>').replace(/<\/b>/g, '</strong>');
            // Экранируем HTML для безопасности (но оставляем наши теги)
            return formatted;
        }

        function displayPlace(place) {
            const container = document.getElementById('placeContainer');
            container.innerHTML = `
                <div class="row">
                    <div class="col-md-12">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/Places">Места отдыха</a></li>
                                <li class="breadcrumb-item active" aria-current="page">${place.name}</li>
                            </ol>
                        </nav>
                    </div>
                </div>
                <div class="card shadow-sm mb-4">
                    ${place.imageUrl ? `<img src="${place.imageUrl}" class="card-img-top" alt="${place.name}" style="max-height: 400px; object-fit: cover;">` : '<div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 300px;"><i class="bi bi-image" style="font-size: 4rem; color: #ccc;"></i></div>'}
                    <div class="card-body">
                        <h1 class="card-title mb-3">${place.name}</h1>
                        <div class="mb-3">
                            ${place.type ? `<span class="badge bg-success me-2 mb-2" style="font-size: 0.9rem;">${place.type}</span>` : ''}
                            ${place.categories.map(cat => `<span class="badge bg-primary me-2 mb-2" style="font-size: 0.9rem;">${cat}</span>`).join('')}
                        </div>
                        <div class="mb-4">
                            <h5 class="mb-3">Описание</h5>
                            <div class="card-text place-description" style="line-height: 1.8; font-size: 1.1rem;">${formatDescription(place.description)}</div>
                        </div>
                        <div class="row mb-4">
                            ${place.address ? `
                                <div class="col-md-6 mb-3">
                                    <h6><i class="bi bi-geo-alt-fill"></i> Адрес</h6>
                                    <p class="mb-0">${place.address}</p>
                                </div>
                            ` : ''}
                            ${place.latitude && place.longitude ? `
                                <div class="col-md-6 mb-3">
                                    <h6><i class="bi bi-geo-alt"></i> Расположение</h6>
                                    <p class="mb-2">Координаты: ${place.latitude}, ${place.longitude}</p>
                                    <a href="https://www.google.com/maps?q=${place.latitude},${place.longitude}" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-map"></i> Открыть на карте
                                    </a>
                                </div>
                            ` : ''}
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center flex-wrap">
                            <div class="mb-2">
                                <span class="badge bg-info fs-6">
                                    <i class="bi bi-heart-fill"></i> ${place.likesCount} лайков
                                </span>
                            </div>
                            <div class="d-flex gap-2 flex-wrap">
                                ${isAdmin() ? `
                                    <button class="btn btn-warning" onclick="showEditModal()">
                                        <i class="bi bi-pencil"></i> Редактировать
                                    </button>
                                ` : ''}
                                <button class="btn ${place.isFavorite ? 'btn-warning' : 'btn-outline-warning'}" onclick="toggleFavorite(${place.id}, ${place.isFavorite ? 'true' : 'false'})">
                                    <i class="bi ${place.isFavorite ? 'bi-star-fill' : 'bi-star'}"></i> ${place.isFavorite ? 'В избранном' : 'В избранное'}
                                </button>
                                <button class="btn ${place.isLiked ? 'btn-danger' : 'btn-outline-danger'}" onclick="toggleLike(${place.id}, ${place.isLiked ? 'true' : 'false'})">
                                    <i class="bi ${place.isLiked ? 'bi-heart-fill' : 'bi-heart'}"></i> ${place.isLiked ? 'Лайкнуто' : 'Лайкнуть'}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
            currentPlace = place;
            if (isEditMode && isAdmin()) {
                showEditModal();
            }
        }

        async function toggleFavorite(placeId, isFavorite) {
            if (!userId) {
                alert('Необходимо войти в систему');
                window.location.href = '/Login';
                return;
            }
            try {
                // Преобразуем строку в булево значение, если нужно
                const isFav = isFavorite === true || isFavorite === 'true';
                const method = isFav ? 'DELETE' : 'POST';
                const response = await fetch(`/api/places/${placeId}/favorites?userId=${userId}`, {
                    method: method
                });
                if (response.ok) {
                    loadPlace();
                } else {
                    const errorData = await response.json();
                    console.error('Ошибка:', errorData);
                }
            } catch (error) {
                console.error('Ошибка:', error);
            }
        }

        async function toggleLike(placeId, isLiked) {
            if (!userId) {
                alert('Необходимо войти в систему');
                window.location.href = '/Login';
                return;
            }
            try {
                // Преобразуем строку в булево значение, если нужно
                const isLk = isLiked === true || isLiked === 'true';
                const method = isLk ? 'DELETE' : 'POST';
                const response = await fetch(`/api/places/${placeId}/likes?userId=${userId}`, {
                    method: method
                });
                if (response.ok) {
                    loadPlace();
                } else {
                    const errorData = await response.json();
                    console.error('Ошибка:', errorData);
                }
            } catch (error) {
                console.error('Ошибка:', error);
            }
        }

        let allCategories = [];
        
        async function loadCategories() {
            try {
                const response = await fetch('/api/categories');
                allCategories = await response.json();
            } catch (error) {
                console.error('Ошибка загрузки категорий:', error);
            }
        }
        
        function showEditModal() {
            if (!isAdmin()) {
                alert('Требуются права администратора');
                return;
            }
            
            if (!currentPlace) {
                alert('Место не загружено');
                return;
            }
            
            // Заполняем форму
            document.getElementById('editPlaceName').value = currentPlace.name || '';
            document.getElementById('editPlaceDescription').value = currentPlace.description || '';
            document.getElementById('editPlaceType').value = currentPlace.type || '';
            document.getElementById('editPlaceAddress').value = currentPlace.address || '';
            document.getElementById('editPlaceLatitude').value = currentPlace.latitude || '';
            document.getElementById('editPlaceLongitude').value = currentPlace.longitude || '';
            document.getElementById('editPlaceImageUrl').value = currentPlace.imageUrl || '';
            
            // Заполняем категории
            renderCategoryCheckboxes(currentPlace.categories || []);
            
            new bootstrap.Modal(document.getElementById('editPlaceModal')).show();
        }
        
        function renderCategoryCheckboxes(selectedCategories = []) {
            const container = document.getElementById('editCategoriesContainer');
            container.innerHTML = '';
            allCategories.forEach(category => {
                const isSelected = selectedCategories.includes(category.name);
                const div = document.createElement('div');
                div.className = 'form-check';
                div.innerHTML = `
                    <input class="form-check-input" type="checkbox" value="${category.id}" 
                           id="editCategory_${category.id}" ${isSelected ? 'checked' : ''}>
                    <label class="form-check-label" for="editCategory_${category.id}">
                        ${category.name}
                    </label>
                `;
                container.appendChild(div);
            });
        }
        
        async function savePlace() {
            if (!isAdmin()) {
                alert('Требуются права администратора');
                return;
            }
            
            const selectedCategories = Array.from(document.querySelectorAll('#editCategoriesContainer input:checked'))
                .map(cb => parseInt(cb.value));
            
            const placeData = {
                name: document.getElementById('editPlaceName').value,
                description: document.getElementById('editPlaceDescription').value,
                type: document.getElementById('editPlaceType').value || null,
                address: document.getElementById('editPlaceAddress').value || null,
                latitude: document.getElementById('editPlaceLatitude').value ? parseFloat(document.getElementById('editPlaceLatitude').value) : null,
                longitude: document.getElementById('editPlaceLongitude').value ? parseFloat(document.getElementById('editPlaceLongitude').value) : null,
                imageUrl: document.getElementById('editPlaceImageUrl').value || null,
                categoryIds: selectedCategories
            };
            
            try {
                const response = await fetch(`/api/admin/places/${placeId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(placeData)
                });
                
                if (response.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('editPlaceModal')).hide();
                    await loadPlace();
                    alert('Место успешно обновлено');
                } else {
                    const error = await response.json();
                    alert('Ошибка: ' + (error.error || 'Не удалось обновить место'));
                }
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Ошибка при обновлении места');
            }
        }
        
        (async () => {
            try {
                await getUserId();
                await loadCategories();
                loadPlace();
            } catch (error) {
                console.error('Ошибка инициализации:', error);
                // Все равно пытаемся загрузить место
                loadPlace();
            }
        })();
    </script>
}

<!-- Модальное окно для редактирования места -->
<div class="modal fade" id="editPlaceModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Редактировать место</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editPlaceForm">
                    <div class="mb-3">
                        <label for="editPlaceName" class="form-label">Название *</label>
                        <input type="text" class="form-control" id="editPlaceName" required>
                    </div>
                    <div class="mb-3">
                        <label for="editPlaceDescription" class="form-label">Описание</label>
                        <textarea class="form-control" id="editPlaceDescription" rows="4"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="editPlaceType" class="form-label">Тип</label>
                        <select class="form-select" id="editPlaceType">
                            <option value="">Не указан</option>
                            <option value="Концерт">Концерт</option>
                            <option value="Ресторан">Ресторан</option>
                            <option value="Парк">Парк</option>
                            <option value="Турнир">Турнир</option>
                            <option value="Выставка">Выставка</option>
                            <option value="Фестиваль">Фестиваль</option>
                            <option value="Спектакль">Спектакль</option>
                            <option value="Кино">Кино</option>
                            <option value="Образование">Образование</option>
                            <option value="Эко тропа">Эко тропа</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="editPlaceAddress" class="form-label">Адрес</label>
                        <input type="text" class="form-control" id="editPlaceAddress">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="editPlaceLatitude" class="form-label">Широта</label>
                            <input type="number" step="0.000001" class="form-control" id="editPlaceLatitude">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="editPlaceLongitude" class="form-label">Долгота</label>
                            <input type="number" step="0.000001" class="form-control" id="editPlaceLongitude">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="editPlaceImageUrl" class="form-label">URL изображения</label>
                        <input type="url" class="form-control" id="editPlaceImageUrl">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Категории</label>
                        <div id="editCategoriesContainer"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary" onclick="savePlace()">Сохранить</button>
            </div>
        </div>
    </div>
</div>

