@page "/Place/{id}"
@model Advisio.Web.Pages.PlaceModel
@{
    ViewData["Title"] = "Место";
}

<div class="container mt-4" id="placeContainer">
    <!-- Детали места будут загружены через JavaScript -->
</div>

@section Scripts {
    <script>
        let userId = null;
        const placeId = @Model.Id;
        
        async function getUserId() {
            try {
                const response = await fetch('/api/auth/check');
                const data = await response.json();
                if (data.isAuthenticated) {
                    userId = data.userId;
                }
            } catch (error) {
                console.error('Ошибка получения userId:', error);
            }
        }

        async function loadPlace() {
            const container = document.getElementById('placeContainer');
            if (!container) {
                console.error('Контейнер для места не найден');
                return;
            }
            
            try {
                // Пытаемся получить userId, если его еще нет
                if (!userId) {
                    try {
                        await getUserId();
                    } catch (e) {
                        console.warn('Не удалось получить userId, продолжаем без него:', e);
                    }
                }
                
                container.innerHTML = '<div class="text-center"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Загрузка...</span></div></div>';
                
                const url = userId ? `/api/places/${placeId}?userId=${userId}` : `/api/places/${placeId}`;
                const response = await fetch(url);
                
                if (response.status === 404) {
                    container.innerHTML = 
                        '<div class="alert alert-warning">Место не найдено</div>';
                    return;
                }
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                const place = await response.json();
                displayPlace(place);
            } catch (error) {
                console.error('Ошибка загрузки места:', error);
                container.innerHTML = 
                    '<div class="alert alert-danger">Ошибка загрузки места. Попробуйте обновить страницу.</div>';
            }
        }

        function formatDescription(description) {
            if (!description) return '';
            // Заменяем переносы строк на <br>
            let formatted = description.replace(/\n/g, '<br>');
            // Заменяем <b> на <strong> для жирного текста
            formatted = formatted.replace(/<b>/g, '<strong>').replace(/<\/b>/g, '</strong>');
            // Экранируем HTML для безопасности (но оставляем наши теги)
            return formatted;
        }

        function displayPlace(place) {
            const container = document.getElementById('placeContainer');
            container.innerHTML = `
                <div class="row">
                    <div class="col-md-12">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item"><a href="/Places">Места отдыха</a></li>
                                <li class="breadcrumb-item active" aria-current="page">${place.name}</li>
                            </ol>
                        </nav>
                    </div>
                </div>
                <div class="card shadow-sm mb-4">
                    ${place.imageUrl ? `<img src="${place.imageUrl}" class="card-img-top" alt="${place.name}" style="max-height: 400px; object-fit: cover;">` : '<div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 300px;"><i class="bi bi-image" style="font-size: 4rem; color: #ccc;"></i></div>'}
                    <div class="card-body">
                        <h1 class="card-title mb-3">${place.name}</h1>
                        <div class="mb-3">
                            ${place.type ? `<span class="badge bg-success me-2 mb-2" style="font-size: 0.9rem;">${place.type}</span>` : ''}
                            ${place.categories.map(cat => `<span class="badge bg-primary me-2 mb-2" style="font-size: 0.9rem;">${cat}</span>`).join('')}
                        </div>
                        <div class="mb-4">
                            <h5 class="mb-3">Описание</h5>
                            <div class="card-text place-description" style="line-height: 1.8; font-size: 1.1rem;">${formatDescription(place.description)}</div>
                        </div>
                        <div class="row mb-4">
                            ${place.address ? `
                                <div class="col-md-6 mb-3">
                                    <h6><i class="bi bi-geo-alt-fill"></i> Адрес</h6>
                                    <p class="mb-0">${place.address}</p>
                                </div>
                            ` : ''}
                            ${place.latitude && place.longitude ? `
                                <div class="col-md-6 mb-3">
                                    <h6><i class="bi bi-geo-alt"></i> Расположение</h6>
                                    <p class="mb-2">Координаты: ${place.latitude}, ${place.longitude}</p>
                                    <a href="https://www.google.com/maps?q=${place.latitude},${place.longitude}" target="_blank" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-map"></i> Открыть на карте
                                    </a>
                                </div>
                            ` : ''}
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between align-items-center flex-wrap">
                            <div class="mb-2">
                                <span class="badge bg-info fs-6">
                                    <i class="bi bi-heart-fill"></i> ${place.likesCount} лайков
                                </span>
                            </div>
                            <div class="d-flex gap-2 flex-wrap">
                                <button class="btn ${place.isFavorite ? 'btn-warning' : 'btn-outline-warning'}" onclick="toggleFavorite(${place.id}, ${place.isFavorite ? 'true' : 'false'})">
                                    <i class="bi ${place.isFavorite ? 'bi-star-fill' : 'bi-star'}"></i> ${place.isFavorite ? 'В избранном' : 'В избранное'}
                                </button>
                                <button class="btn ${place.isLiked ? 'btn-danger' : 'btn-outline-danger'}" onclick="toggleLike(${place.id}, ${place.isLiked ? 'true' : 'false'})">
                                    <i class="bi ${place.isLiked ? 'bi-heart-fill' : 'bi-heart'}"></i> ${place.isLiked ? 'Лайкнуто' : 'Лайкнуть'}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }

        async function toggleFavorite(placeId, isFavorite) {
            if (!userId) {
                alert('Необходимо войти в систему');
                window.location.href = '/Login';
                return;
            }
            try {
                // Преобразуем строку в булево значение, если нужно
                const isFav = isFavorite === true || isFavorite === 'true';
                const method = isFav ? 'DELETE' : 'POST';
                const response = await fetch(`/api/places/${placeId}/favorites?userId=${userId}`, {
                    method: method
                });
                if (response.ok) {
                    loadPlace();
                } else {
                    const errorData = await response.json();
                    console.error('Ошибка:', errorData);
                }
            } catch (error) {
                console.error('Ошибка:', error);
            }
        }

        async function toggleLike(placeId, isLiked) {
            if (!userId) {
                alert('Необходимо войти в систему');
                window.location.href = '/Login';
                return;
            }
            try {
                // Преобразуем строку в булево значение, если нужно
                const isLk = isLiked === true || isLiked === 'true';
                const method = isLk ? 'DELETE' : 'POST';
                const response = await fetch(`/api/places/${placeId}/likes?userId=${userId}`, {
                    method: method
                });
                if (response.ok) {
                    loadPlace();
                } else {
                    const errorData = await response.json();
                    console.error('Ошибка:', errorData);
                }
            } catch (error) {
                console.error('Ошибка:', error);
            }
        }

        (async () => {
            try {
                await getUserId();
                loadPlace();
            } catch (error) {
                console.error('Ошибка инициализации:', error);
                // Все равно пытаемся загрузить место
                loadPlace();
            }
        })();
    </script>
}

