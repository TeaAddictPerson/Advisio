@page
@model Advisio.Web.Pages.AdminModel
@{
    ViewData["Title"] = "Администрирование";
}

<div class="container mt-4">
    <h1 class="mb-4">Администрирование</h1>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5>Синхронизация мест</h5>
                </div>
                <div class="card-body">
                    <p>Загрузить все доступные места из внешних API (Kufar.by и Kvitki.by) и присвоить им категории.</p>
                    <form method="post" asp-page-handler="SyncPlaces">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-arrow-clockwise"></i> Запустить синхронизацию
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5>Присвоение категорий</h5>
                </div>
                <div class="card-body">
                    <p>Присвоить категории всем местам, у которых их нет.</p>
                    <form method="post" asp-page-handler="AssignCategories">
                        <button type="submit" class="btn btn-secondary">
                            <i class="bi bi-tags"></i> Присвоить категории
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info mt-4">
        <h6>Текущие настройки синхронизации:</h6>
        <ul class="mb-0">
            <li>Интервал синхронизации: <strong>1 час</strong></li>
            <li>Количество мест: <strong>Все доступные</strong></li>
            <li>Рекомендации: <strong>9 вариантов</strong></li>
        </ul>
    </div>
</div>


