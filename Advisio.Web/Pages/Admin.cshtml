@page
@model Advisio.Web.Pages.AdminModel
@{
    ViewData["Title"] = "Администрирование";
}

<div class="container mt-4">
    <h1 class="mb-4">Администрирование</h1>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.Message
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Навигация по разделам -->
    <ul class="nav nav-tabs mb-4" id="adminTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="sync-tab" data-bs-toggle="tab" data-bs-target="#sync" type="button" role="tab">
                Синхронизация
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="places-tab" data-bs-toggle="tab" data-bs-target="#places" type="button" role="tab">
                Управление местами
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="survey-tab" data-bs-toggle="tab" data-bs-target="#survey" type="button" role="tab">
                Управление опросом
            </button>
        </li>
    </ul>

    <div class="tab-content" id="adminTabContent">
        <!-- Синхронизация -->
        <div class="tab-pane fade show active" id="sync" role="tabpanel">
            <div class="row">
                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5>Синхронизация мест</h5>
                        </div>
                        <div class="card-body">
                            <p>Загрузить все доступные места из PredictHQ API и присвоить им категории.</p>
                            <form method="post" asp-page-handler="SyncPlaces">
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-arrow-clockwise"></i> Запустить синхронизацию
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5>Присвоение категорий</h5>
                        </div>
                        <div class="card-body">
                            <p>Присвоить категории всем местам, у которых их нет.</p>
                            <form method="post" asp-page-handler="AssignCategories">
                                <button type="submit" class="btn btn-secondary">
                                    <i class="bi bi-tags"></i> Присвоить категории
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Управление местами -->
        <div class="tab-pane fade" id="places" role="tabpanel">
            <div class="mb-3">
                <button class="btn btn-success" onclick="showCreatePlaceModal()">
                    <i class="bi bi-plus-circle"></i> Добавить место
                </button>
            </div>
            
            <div id="placesListContainer">
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Загрузка...</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Управление опросом -->
        <div class="tab-pane fade" id="survey" role="tabpanel">
            <div class="mb-3">
                <button class="btn btn-success" onclick="showAddQuestionModal()">
                    <i class="bi bi-plus-circle"></i> Добавить вопрос
                </button>
            </div>
            
            <div id="surveyQuestionsContainer">
                <div class="text-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Загрузка...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно для создания/редактирования места -->
<div class="modal fade" id="placeModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="placeModalTitle">Добавить место</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="placeForm">
                    <input type="hidden" id="placeId" />
                    <div class="mb-3">
                        <label for="placeName" class="form-label">Название *</label>
                        <input type="text" class="form-control" id="placeName" required>
                    </div>
                    <div class="mb-3">
                        <label for="placeDescription" class="form-label">Описание</label>
                        <textarea class="form-control" id="placeDescription" rows="4"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="placeType" class="form-label">Тип</label>
                        <select class="form-select" id="placeType">
                            <option value="">Не указан</option>
                            <option value="Концерт">Концерт</option>
                            <option value="Ресторан">Ресторан</option>
                            <option value="Парк">Парк</option>
                            <option value="Турнир">Турнир</option>
                            <option value="Выставка">Выставка</option>
                            <option value="Фестиваль">Фестиваль</option>
                            <option value="Спектакль">Спектакль</option>
                            <option value="Кино">Кино</option>
                            <option value="Образование">Образование</option>
                            <option value="Эко тропа">Эко тропа</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="placeAddress" class="form-label">Адрес</label>
                        <input type="text" class="form-control" id="placeAddress">
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="placeLatitude" class="form-label">Широта</label>
                            <input type="number" step="0.000001" class="form-control" id="placeLatitude">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="placeLongitude" class="form-label">Долгота</label>
                            <input type="number" step="0.000001" class="form-control" id="placeLongitude">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="placeImageUrl" class="form-label">URL изображения</label>
                        <input type="url" class="form-control" id="placeImageUrl">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Категории</label>
                        <div id="categoriesCheckboxes"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary" onclick="savePlace()">Сохранить</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно для добавления вопроса -->
<div class="modal fade" id="questionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Добавить вопрос</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="questionForm">
                    <div class="mb-3">
                        <label for="questionText" class="form-label">Текст вопроса *</label>
                        <textarea class="form-control" id="questionText" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="questionOrder" class="form-label">Порядок</label>
                        <input type="number" class="form-control" id="questionOrder" value="1">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ответы</label>
                        <div id="answersContainer">
                            <div class="answer-item mb-2">
                                <div class="input-group">
                                    <input type="text" class="form-control answer-text" placeholder="Текст ответа">
                                    <input type="number" class="form-control answer-weight" placeholder="Вес" value="0" style="max-width: 100px;">
                                    <button type="button" class="btn btn-outline-danger" onclick="removeAnswer(this)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addAnswer()">
                            <i class="bi bi-plus"></i> Добавить ответ
                        </button>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" class="btn btn-primary" onclick="saveQuestion()">Сохранить</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let allCategories = [];
        let allPlaces = [];
        let allQuestions = [];
        let editingPlaceId = null;

        async function loadCategories() {
            try {
                const response = await fetch('/api/categories');
                allCategories = await response.json();
            } catch (error) {
                console.error('Ошибка загрузки категорий:', error);
            }
        }

        function renderCategoriesCheckboxes(selectedIds = []) {
            const container = document.getElementById('categoriesCheckboxes');
            container.innerHTML = '';
            allCategories.forEach(category => {
                const div = document.createElement('div');
                div.className = 'form-check';
                div.innerHTML = `
                    <input class="form-check-input" type="checkbox" value="${category.id}" 
                           id="category_${category.id}" ${selectedIds.includes(category.id) ? 'checked' : ''}>
                    <label class="form-check-label" for="category_${category.id}">
                        ${category.name}
                    </label>
                `;
                container.appendChild(div);
            });
        }

        async function loadPlaces() {
            try {
                const response = await fetch('/api/places?pageSize=1000');
                const result = await response.json();
                allPlaces = result.items || result.Items || [];
                displayPlaces();
            } catch (error) {
                console.error('Ошибка загрузки мест:', error);
            }
        }

        function displayPlaces() {
            const container = document.getElementById('placesListContainer');
            if (allPlaces.length === 0) {
                container.innerHTML = '<div class="alert alert-info">Места не найдены</div>';
                return;
            }

            let html = '<div class="table-responsive"><table class="table"><thead><tr>' +
                '<th>ID</th><th>Название</th><th>Тип</th><th>Адрес</th><th>Действия</th>' +
                '</tr></thead><tbody>';

            allPlaces.forEach(place => {
                html += `
                    <tr>
                        <td>${place.id}</td>
                        <td>${place.name}</td>
                        <td>${place.type || '-'}</td>
                        <td>${place.address || '-'}</td>
                        <td>
                            <button class="btn btn-sm btn-primary" onclick="editPlace(${place.id})">
                                <i class="bi bi-pencil"></i> Редактировать
                            </button>
                            <button class="btn btn-sm btn-danger" onclick="deletePlace(${place.id})">
                                <i class="bi bi-trash"></i> Удалить
                            </button>
                        </td>
                    </tr>
                `;
            });

            html += '</tbody></table></div>';
            container.innerHTML = html;
        }

        function showCreatePlaceModal() {
            editingPlaceId = null;
            document.getElementById('placeModalTitle').textContent = 'Добавить место';
            document.getElementById('placeForm').reset();
            document.getElementById('placeId').value = '';
            renderCategoriesCheckboxes();
            new bootstrap.Modal(document.getElementById('placeModal')).show();
        }

        async function editPlace(id) {
            const place = allPlaces.find(p => p.id === id);
            if (!place) return;

            editingPlaceId = id;
            document.getElementById('placeModalTitle').textContent = 'Редактировать место';
            document.getElementById('placeId').value = id;
            document.getElementById('placeName').value = place.name;
            document.getElementById('placeDescription').value = place.description || '';
            document.getElementById('placeType').value = place.type || '';
            document.getElementById('placeAddress').value = place.address || '';
            document.getElementById('placeLatitude').value = place.latitude || '';
            document.getElementById('placeLongitude').value = place.longitude || '';
            document.getElementById('placeImageUrl').value = place.imageUrl || '';

            // Получаем полную информацию о месте для категорий
            try {
                const response = await fetch(`/api/places/${id}`);
                const fullPlace = await response.json();
                const categoryIds = fullPlace.categories?.map(cat => {
                    const category = allCategories.find(c => c.name === cat);
                    return category?.id;
                }).filter(id => id) || [];
                renderCategoriesCheckboxes(categoryIds);
            } catch (error) {
                console.error('Ошибка загрузки места:', error);
                renderCategoriesCheckboxes();
            }

            new bootstrap.Modal(document.getElementById('placeModal')).show();
        }

        async function savePlace() {
            const form = document.getElementById('placeForm');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const selectedCategories = Array.from(document.querySelectorAll('#categoriesCheckboxes input:checked'))
                .map(cb => parseInt(cb.value));

            const placeData = {
                name: document.getElementById('placeName').value,
                description: document.getElementById('placeDescription').value,
                type: document.getElementById('placeType').value || null,
                address: document.getElementById('placeAddress').value || null,
                latitude: document.getElementById('placeLatitude').value ? parseFloat(document.getElementById('placeLatitude').value) : null,
                longitude: document.getElementById('placeLongitude').value ? parseFloat(document.getElementById('placeLongitude').value) : null,
                imageUrl: document.getElementById('placeImageUrl').value || null,
                categoryIds: selectedCategories
            };

            try {
                const placeId = document.getElementById('placeId').value;
                let response;
                
                if (placeId) {
                    // Обновление
                    response = await fetch(`/api/admin/places/${placeId}`, {
                        method: 'PUT',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(placeData)
                    });
                } else {
                    // Создание
                    response = await fetch('/api/admin/places', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(placeData)
                    });
                }

                if (response.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('placeModal')).hide();
                    await loadPlaces();
                    alert('Место успешно сохранено');
                } else {
                    const error = await response.json();
                    alert('Ошибка: ' + (error.error || 'Не удалось сохранить место'));
                }
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Ошибка при сохранении места');
            }
        }

        async function deletePlace(id) {
            if (!confirm('Вы уверены, что хотите удалить это место?')) return;

            try {
                const response = await fetch(`/api/admin/places/${id}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    await loadPlaces();
                    alert('Место успешно удалено');
                } else {
                    const error = await response.json();
                    alert('Ошибка: ' + (error.error || 'Не удалось удалить место'));
                }
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Ошибка при удалении места');
            }
        }

        async function loadSurveyQuestions() {
            try {
                const response = await fetch('/api/survey/active');
                if (response.status === 404) {
                    document.getElementById('surveyQuestionsContainer').innerHTML = 
                        '<div class="alert alert-info">Активный опрос не найден</div>';
                    return;
                }
                const survey = await response.json();
                allQuestions = survey.questions || [];
                displayQuestions();
            } catch (error) {
                console.error('Ошибка загрузки вопросов:', error);
            }
        }

        function displayQuestions() {
            const container = document.getElementById('surveyQuestionsContainer');
            if (allQuestions.length === 0) {
                container.innerHTML = '<div class="alert alert-info">Вопросы не найдены</div>';
                return;
            }

            let html = '<div class="list-group">';
            allQuestions.forEach(question => {
                html += `
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1">
                                <h6>${question.order}. ${question.questionText}</h6>
                                <ul class="list-unstyled mt-2">
                                    ${question.answers.map(answer => 
                                        `<li><small>${answer.answerText} (вес: ${answer.weight})</small></li>`
                                    ).join('')}
                                </ul>
                            </div>
                            <button class="btn btn-sm btn-danger" onclick="deleteQuestion(${question.id})">
                                <i class="bi bi-trash"></i> Удалить
                            </button>
                        </div>
                    </div>
                `;
            });
            html += '</div>';
            container.innerHTML = html;
        }

        function showAddQuestionModal() {
            document.getElementById('questionForm').reset();
            document.getElementById('questionOrder').value = allQuestions.length + 1;
            document.getElementById('answersContainer').innerHTML = `
                <div class="answer-item mb-2">
                    <div class="input-group">
                        <input type="text" class="form-control answer-text" placeholder="Текст ответа">
                        <input type="number" class="form-control answer-weight" placeholder="Вес" value="0" style="max-width: 100px;">
                        <button type="button" class="btn btn-outline-danger" onclick="removeAnswer(this)">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            `;
            new bootstrap.Modal(document.getElementById('questionModal')).show();
        }

        function addAnswer() {
            const container = document.getElementById('answersContainer');
            const div = document.createElement('div');
            div.className = 'answer-item mb-2';
            div.innerHTML = `
                <div class="input-group">
                    <input type="text" class="form-control answer-text" placeholder="Текст ответа">
                    <input type="number" class="form-control answer-weight" placeholder="Вес" value="0" style="max-width: 100px;">
                    <button type="button" class="btn btn-outline-danger" onclick="removeAnswer(this)">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `;
            container.appendChild(div);
        }

        function removeAnswer(button) {
            button.closest('.answer-item').remove();
        }

        async function saveQuestion() {
            const questionText = document.getElementById('questionText').value;
            const questionOrder = parseInt(document.getElementById('questionOrder').value) || 1;
            
            if (!questionText.trim()) {
                alert('Введите текст вопроса');
                return;
            }

            const answers = Array.from(document.querySelectorAll('.answer-item')).map(item => {
                const text = item.querySelector('.answer-text').value;
                const weight = parseInt(item.querySelector('.answer-weight').value) || 0;
                return { answerText: text, weight: weight };
            }).filter(a => a.answerText.trim());

            if (answers.length === 0) {
                alert('Добавьте хотя бы один ответ');
                return;
            }

            try {
                const response = await fetch('/api/admin/survey/add-question', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        questionText: questionText,
                        order: questionOrder,
                        answers: answers
                    })
                });

                if (response.ok) {
                    bootstrap.Modal.getInstance(document.getElementById('questionModal')).hide();
                    await loadSurveyQuestions();
                    alert('Вопрос успешно добавлен');
                } else {
                    const error = await response.json();
                    alert('Ошибка: ' + (error.error || 'Не удалось добавить вопрос'));
                }
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Ошибка при добавлении вопроса');
            }
        }

        async function deleteQuestion(questionId) {
            if (!confirm('Вы уверены, что хотите удалить этот вопрос? Все ответы также будут удалены.')) return;

            try {
                const response = await fetch(`/api/admin/survey/delete-question/${questionId}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    await loadSurveyQuestions();
                    alert('Вопрос успешно удален');
                } else {
                    const error = await response.json();
                    alert('Ошибка: ' + (error.error || 'Не удалось удалить вопрос'));
                }
            } catch (error) {
                console.error('Ошибка:', error);
                alert('Ошибка при удалении вопроса');
            }
        }

        // Инициализация при загрузке страницы
        (async () => {
            await loadCategories();
            
            // Загружаем данные при переключении вкладок
            document.getElementById('places-tab').addEventListener('shown.bs.tab', async () => {
                await loadPlaces();
            });
            
            document.getElementById('survey-tab').addEventListener('shown.bs.tab', async () => {
                await loadSurveyQuestions();
            });
        })();
    </script>
}
