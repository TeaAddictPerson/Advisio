@page
@model Advisio.Web.Pages.PlacesModel
@{
    ViewData["Title"] = "Места отдыха";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Места отдыха</h1>
        <button class="btn btn-outline-primary" onclick="syncPlaces()" id="syncButton">
            <i class="bi bi-arrow-clockwise"></i> Загрузить больше мест
        </button>
    </div>
    
    <div class="row mb-3">
        <div class="col-md-4">
            <input type="text" id="searchInput" class="form-control" placeholder="Поиск мест..." oninput="handleSearch()">
        </div>
        <div class="col-md-4">
            <select id="categoryFilter" class="form-select" onchange="handleFilter()">
                <option value="">Все категории</option>
            </select>
        </div>
        <div class="col-md-4">
            <select id="sortBy" class="form-select" onchange="handleFilter()">
                <option value="">Сортировка по умолчанию</option>
                <option value="name">По названию (А-Я)</option>
                <option value="name_desc">По названию (Я-А)</option>
                <option value="likes">По лайкам (больше)</option>
                <option value="likes_asc">По лайкам (меньше)</option>
                <option value="created">По дате (новые)</option>
                <option value="created_asc">По дате (старые)</option>
            </select>
        </div>
    </div>

    <div id="loadingIndicator" class="text-center mb-3" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Загрузка...</span>
        </div>
    </div>
    
    <div id="placesContainer" class="row">
        <!-- Места будут загружены через JavaScript -->
    </div>
</div>

@section Scripts {
    <script>
        let userId = null;
        let allPlaces = [];
        let searchTimeout = null;
        
        async function getUserId() {
            try {
                const response = await fetch('/api/auth/check');
                const data = await response.json();
                if (data.isAuthenticated) {
                    userId = data.userId;
                }
            } catch (error) {
                console.error('Ошибка получения userId:', error);
            }
        }
        
        async function loadCategories() {
            try {
                const response = await fetch('/api/categories');
                const categories = await response.json();
                const categoryFilter = document.getElementById('categoryFilter');
                
                categories.forEach(category => {
                    const option = document.createElement('option');
                    option.value = category.id;
                    option.textContent = category.name;
                    categoryFilter.appendChild(option);
                });
            } catch (error) {
                console.error('Ошибка загрузки категорий:', error);
            }
        }
        
        async function loadPlaces() {
            try {
                const loadingIndicator = document.getElementById('loadingIndicator');
                const container = document.getElementById('placesContainer');
                loadingIndicator.style.display = 'block';
                container.innerHTML = '';
                
                const searchQuery = document.getElementById('searchInput').value.trim();
                const categoryIdValue = document.getElementById('categoryFilter').value;
                const sortBy = document.getElementById('sortBy').value;
                
                // Формируем URL с правильными параметрами
                const params = new URLSearchParams();
                
                if (userId) {
                    params.append('userId', userId);
                }
                if (searchQuery) {
                    params.append('search', searchQuery);
                }
                if (categoryIdValue && categoryIdValue !== '' && categoryIdValue !== '0') {
                    const categoryId = parseInt(categoryIdValue);
                    if (!isNaN(categoryId) && categoryId > 0) {
                        params.append('categoryId', categoryId);
                        console.log('Фильтр по категории:', categoryId);
                    } else {
                        console.warn('Некорректный categoryId:', categoryIdValue);
                    }
                }
                if (sortBy) {
                    params.append('sortBy', sortBy);
                }
                
                const queryString = params.toString();
                const url = `/api/places${queryString ? '?' + queryString : ''}`;
                
                console.log('Запрос мест:', url);
                const response = await fetch(url);
                if (!response.ok) {
                    const errorText = await response.text();
                    console.error('Ошибка ответа:', response.status, errorText);
                    let errorMessage = `Ошибка загрузки мест (${response.status})`;
                    try {
                        const errorJson = JSON.parse(errorText);
                        if (errorJson.error) {
                            errorMessage = errorJson.error;
                            if (errorJson.details) {
                                console.error('Детали ошибки:', errorJson.details);
                            }
                        }
                    } catch (e) {
                        console.error('Не удалось распарсить ошибку:', e);
                    }
                    throw new Error(errorMessage);
                }
                const places = await response.json();
                console.log('Получено мест:', places.length);
                allPlaces = places;
                
                const syncButton = document.getElementById('syncButton');
                if (places.length < 20 && syncButton) {
                    syncButton.style.display = 'block';
                } else if (syncButton) {
                    syncButton.style.display = 'none';
                }
                
                displayPlaces(places);
            } catch (error) {
                console.error('Ошибка загрузки мест:', error);
                document.getElementById('placesContainer').innerHTML = 
                    '<div class="col-12"><div class="alert alert-danger">Ошибка загрузки мест. Попробуйте обновить страницу.</div></div>';
            } finally {
                document.getElementById('loadingIndicator').style.display = 'none';
            }
        }
        
        function handleSearch() {
            // Debounce для поиска
            clearTimeout(searchTimeout);
            searchTimeout = setTimeout(() => {
                loadPlaces();
            }, 300);
        }
        
        function handleFilter() {
            loadPlaces();
        }

        function displayPlaces(places) {
            const container = document.getElementById('placesContainer');
            container.innerHTML = '';

            if (places.length === 0) {
                const searchQuery = document.getElementById('searchInput').value.trim();
                const categoryId = document.getElementById('categoryFilter').value;
                
                let message = 'Места не найдены';
                if (searchQuery || categoryId) {
                    message = 'По вашему запросу ничего не найдено. Попробуйте изменить параметры поиска или фильтрации.';
                }
                
                container.innerHTML = `
                    <div class="col-12">
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> ${message}
                        </div>
                    </div>`;
                return;
            }

            places.forEach(place => {
                const card = `
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            ${place.imageUrl ? `<img src="${place.imageUrl}" class="card-img-top" alt="${place.name}" style="height: 200px; object-fit: cover;">` : ''}
                            <div class="card-body">
                                <h5 class="card-title">${place.name}</h5>
                                <p class="card-text">${place.description.substring(0, 100)}${place.description.length > 100 ? '...' : ''}</p>
                                <div class="mb-2">
                                    ${place.categories.map(cat => `<span class="badge bg-secondary me-1">${cat}</span>`).join('')}
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <small class="text-muted">${place.likesCount} лайков</small>
                                    <div>
                                        <button class="btn btn-sm ${place.isFavorite ? 'btn-warning' : 'btn-outline-warning'}" onclick="toggleFavorite(${place.id})">
                                            ${place.isFavorite ? '★' : '☆'}
                                        </button>
                                        <button class="btn btn-sm ${place.isLiked ? 'btn-danger' : 'btn-outline-danger'}" onclick="toggleLike(${place.id})">
                                            ${place.isLiked ? '❤️' : '🤍'}
                                        </button>
                                    </div>
                                </div>
                                <a href="/Place/${place.id}" class="btn btn-primary btn-sm mt-2">Подробнее</a>
                            </div>
                        </div>
                    </div>
                `;
                container.innerHTML += card;
            });
        }

        async function toggleFavorite(placeId) {
            if (!userId) {
                alert('Необходимо войти в систему');
                window.location.href = '/Login';
                return;
            }
            try {
                const response = await fetch(`/api/places/${placeId}/favorites?userId=${userId}`, {
                    method: 'POST'
                });
                if (response.ok) {
                    loadPlaces();
                }
            } catch (error) {
                console.error('Ошибка:', error);
            }
        }

        async function toggleLike(placeId) {
            if (!userId) {
                alert('Необходимо войти в систему');
                window.location.href = '/Login';
                return;
            }
            try {
                const response = await fetch(`/api/places/${placeId}/likes?userId=${userId}`, {
                    method: 'POST'
                });
                if (response.ok) {
                    loadPlaces();
                }
            } catch (error) {
                console.error('Ошибка:', error);
            }
        }

        async function assignCategoriesIfNeeded() {
            try {
                // Вызываем метод присвоения категорий при первой загрузке
                const response = await fetch('/api/admin/assign-categories', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                if (response.ok) {
                    const result = await response.json();
                    console.log('Категории присвоены:', result.message);
                } else {
                    const errorText = await response.text();
                    console.warn('Не удалось присвоить категории:', response.status, errorText);
                }
            } catch (error) {
                console.warn('Ошибка при присвоении категорий (это нормально, если они уже присвоены):', error);
            }
        }

        async function syncPlaces() {
            const syncButton = document.getElementById('syncButton');
            if (syncButton) {
                syncButton.disabled = true;
                syncButton.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Загрузка...';
            }
            
            try {
                const response = await fetch('/api/admin/sync-places', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                
                if (response.ok) {
                    const result = await response.json();
                    alert('Синхронизация завершена! Загружены новые места.');
                    loadPlaces();
                } else {
                    const error = await response.json();
                    alert('Ошибка синхронизации: ' + (error.error || 'Неизвестная ошибка'));
                }
            } catch (error) {
                console.error('Ошибка синхронизации:', error);
                alert('Ошибка при синхронизации мест');
            } finally {
                if (syncButton) {
                    syncButton.disabled = false;
                    syncButton.innerHTML = '<i class="bi bi-arrow-clockwise"></i> Загрузить больше мест';
                }
            }
        }

        (async () => {
            try {
                await getUserId();
                await loadCategories();
                assignCategoriesIfNeeded().catch(err => console.warn('Фоновая задача присвоения категорий:', err));
                loadPlaces();
            } catch (error) {
                console.error('Ошибка инициализации:', error);
            }
        })();
    </script>
}

