{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=AdvisioDb;Trusted_Connection=true;MultipleActiveResultSets=true"
  },
  "ExternalApis": {
    "KufarApi": "https://api.kufar.by/search-api/v1/search/rendered-paginated",
    "KvitkiApi": "https://www.kvitki.by/api/events"
  },
  "PlacesSync": {
    "Enabled": true,
    "IntervalHours": 0.25,
    "RetryCount": 3,
    "RetryDelaySeconds": 60,
    "MaxPlacesPerSync": 2000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
